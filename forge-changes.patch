+*{margin:0;padding:0;box-sizing:border-box;}
+:root{
+  --fire1:#FF6B1A;--fire2:#FF9500;--fire3:#FFB800;
+  --ember:#FF3D00;--teal:#4DD9E8;--teal2:#2BB5C8;
+  --steel:#C8D8E4;--steel2:#B8C8D8;--steel3:#7A90A8;
+  --iron:#202C3C;--iron2:#1A2535;--iron3:#141E2C;
+  --forge:#080C14;--white:#F4F8FC;
+}
+html{scroll-behavior:smooth;}
+body{font-family:'DM Sans',sans-serif;background:var(--forge);color:var(--white);min-height:100vh;line-height:1.6;overflow-x:hidden;}
+body:not(.auth-ready) .auth-sensitive{visibility:hidden;}
+.background{position:fixed;inset:0;z-index:-1;background:radial-gradient(ellipse 60% 40% at 50% 100%,rgba(255,107,26,0.05) 0%,transparent 60%),radial-gradient(ellipse 40% 30% at 20% 80%,rgba(255,61,0,0.03) 0%,transparent 50%),linear-gradient(180deg,#080C14 0%,#0B1018 40%,#0A0E1A 70%,#0D1020 100%);}
+/* Nav */
+.site-nav,.site-header{position:sticky;top:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:0 48px;background:rgba(8,12,20,0.92);backdrop-filter:blur(24px);border-bottom:1px solid rgba(255,107,26,0.08);min-height:72px;}
+.site-nav::after,.site-header::after{content:'';position:absolute;bottom:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(255,107,26,0.2),rgba(77,217,232,0.15),rgba(255,107,26,0.2),transparent);}
+.nav-shell{width:100%;display:flex;align-items:center;justify-content:space-between;gap:20px;}
+.brand{display:flex;align-items:center;gap:12px;text-decoration:none;}
+.brand-logo{width:52px;height:52px;flex-shrink:0;filter:drop-shadow(0 0 12px rgba(77,217,232,0.35)) drop-shadow(0 0 24px rgba(255,107,26,0.2));}
+.brand-logo img,.top-logo{width:52px;height:52px;object-fit:contain;display:block;}
+.brand-text{display:flex;flex-direction:column;gap:1px;}
+.brand-name{font-family:'Barlow Condensed',sans-serif;font-size:1.3rem;font-weight:800;letter-spacing:0.06em;text-transform:uppercase;color:var(--white);line-height:1;}
+.brand-sub{font-family:'Rajdhani',sans-serif;font-size:0.62rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;background:linear-gradient(90deg,var(--fire2),var(--teal));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
+.nav-links{display:flex;align-items:center;gap:28px;flex-wrap:wrap;}
+.nav-links a,.nav-links button.linklike{font-family:'Rajdhani',sans-serif;font-size:0.85rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--steel2);text-decoration:none;background:transparent;border:none;cursor:pointer;padding:0;transition:color 0.2s;}
+.nav-links a:hover,.nav-links button.linklike:hover{color:var(--white);}
+.nav-cta{font-family:'Barlow Condensed',sans-serif;font-size:0.85rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;padding:10px 24px;background:linear-gradient(135deg,var(--fire1),var(--fire2));color:#fff;border:none;cursor:pointer;text-decoration:none;clip-path:polygon(8px 0%,100% 0%,calc(100% - 8px) 100%,0% 100%);transition:all 0.22s;box-shadow:0 4px 20px rgba(255,107,26,0.25);display:inline-flex;align-items:center;}
+.nav-cta:hover{transform:translateY(-1px);box-shadow:0 6px 28px rgba(255,107,26,0.4);}
+/* Layout */
+.page{max-width:1100px;margin:0 auto;padding:42px 24px 80px;}
+/* Cards / panels */
+.card,.seo-panel,.seo-detail-panel,.related-tools{background:var(--iron);border:1px solid rgba(255,107,26,0.1);padding:32px;margin-bottom:24px;position:relative;overflow:hidden;}
+.card::before,.seo-panel::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--ember),var(--fire2));opacity:0.4;}
+/* Badges */
+.seo-kicker,.tool-badge{display:inline-block;margin-bottom:10px;padding:6px 14px;background:rgba(255,107,26,0.06);border:1px solid rgba(255,107,26,0.15);font-family:'Rajdhani',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:var(--fire2);}
+/* Typography */
+.seo-panel h1,.title{font-family:'Barlow Condensed',sans-serif;font-size:2.4rem;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;color:var(--white);line-height:1.1;margin-bottom:12px;}
+.subtitle,.seo-panel p,.seo-detail-panel p,.related-tools p{font-size:0.96rem;line-height:1.75;color:rgba(244,248,252,0.82);margin-bottom:14px;}
+.seo-detail-panel h2,.related-tools h2{font-family:'Barlow Condensed',sans-serif;font-size:1.6rem;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;color:var(--white);margin-bottom:10px;}
+.seo-detail-panel h3{font-family:'Rajdhani',sans-serif;font-size:0.95rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--fire2);margin:16px 0 8px;}
+.seo-panel ul,.seo-detail-panel ul{margin-left:20px;margin-bottom:14px;}
+.seo-panel li,.seo-detail-panel li{color:rgba(244,248,252,0.8);margin-bottom:6px;}
+.inline-links{color:rgba(244,248,252,0.8);}
+.inline-links a,.related-tools a,.related-tools-links a{color:var(--fire2);text-decoration:none;font-weight:600;}
+.inline-links a:hover,.related-tools a:hover,.related-tools-links a:hover{color:var(--fire3);text-decoration:underline;}
+.related-tools-links{display:flex;flex-wrap:wrap;gap:12px;margin-top:8px;}
+/* Back link */
+.back-link{display:inline-flex;align-items:center;gap:8px;color:var(--steel2);text-decoration:none;font-weight:600;font-family:'Rajdhani',sans-serif;font-size:0.85rem;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:22px;transition:color 0.2s;}
+.back-link:hover{color:var(--fire2);}
+/* Form labels */
+.examples-label,.field-label,.result-label{font-family:'Rajdhani',sans-serif;font-size:0.8rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--fire2);margin-bottom:8px;display:block;}
+/* Example chips */
+.examples{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px;}
+.example-chip{border:1px solid rgba(255,107,26,0.15);background:rgba(255,107,26,0.04);color:var(--steel2);padding:8px 14px;cursor:pointer;font-weight:600;font-size:0.85rem;font-family:'Rajdhani',sans-serif;letter-spacing:0.04em;transition:0.18s ease;border-radius:0;}
+.example-chip:hover{border-color:var(--fire1);color:var(--white);background:rgba(255,107,26,0.1);}
+/* Inputs */
+textarea{width:100%;min-height:240px;border:1px solid rgba(255,107,26,0.1);background:rgba(8,12,20,0.6);color:var(--white);padding:16px;font-size:15px;font-family:'DM Sans',sans-serif;resize:vertical;outline:none;line-height:1.6;border-radius:0;}
+textarea::placeholder{color:var(--steel3);}
+textarea:focus{border-color:rgba(255,107,26,0.35);box-shadow:0 0 0 1px rgba(255,107,26,0.08);}
+select{width:100%;padding:13px;border:1px solid rgba(255,107,26,0.1);background:rgba(8,12,20,0.6);color:var(--white);outline:none;font-size:14px;font-family:'DM Sans',sans-serif;cursor:pointer;appearance:none;border-radius:0;}
+select:focus{border-color:rgba(255,107,26,0.35);}
+select option{background:#0D1020;color:var(--white);}
+.grid{display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:18px;align-items:start;}
+.top-row{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;flex-wrap:wrap;margin-bottom:18px;}
+.top-copy{flex:1;min-width:260px;}
+.meta-row{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;color:var(--steel3);margin:12px 0 18px;font-size:0.9rem;}
+/* Usage pill */
+.usage-pill{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:8px 16px;border:1px solid rgba(255,107,26,0.15);background:rgba(255,107,26,0.05);color:var(--steel2);font-weight:700;font-size:0.9rem;white-space:nowrap;font-family:'Rajdhani',sans-serif;letter-spacing:0.06em;border-radius:0;}
+.usage-pill.pro{background:rgba(255,107,26,0.1);border-color:var(--fire1);color:var(--fire2);}
+/* Buttons */
+.actions{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px;}
+button{border:none;padding:11px 20px;font-weight:700;cursor:pointer;transition:0.18s ease;font-family:'Barlow Condensed',sans-serif;font-size:0.9rem;letter-spacing:0.08em;text-transform:uppercase;border-radius:0;}
+.primary-btn{background:linear-gradient(135deg,var(--fire1),var(--fire2));color:#fff;clip-path:polygon(6px 0%,100% 0%,calc(100% - 6px) 100%,0% 100%);box-shadow:0 4px 20px rgba(255,107,26,0.22);}
+.primary-btn:hover{transform:translateY(-1px);box-shadow:0 6px 28px rgba(255,107,26,0.38);}
+.secondary-btn{background:rgba(255,255,255,0.04);color:var(--steel2);border:1px solid rgba(200,216,228,0.12);}
+.secondary-btn:hover{border-color:var(--steel2);color:var(--white);background:rgba(255,255,255,0.07);}
+button:disabled{opacity:0.5;cursor:not-allowed;transform:none !important;box-shadow:none !important;}
+/* Status */
+.status-line{min-height:22px;margin-bottom:12px;font-size:0.9rem;font-weight:600;color:var(--steel2);}
+.status-line.error{color:#ff8a8a;}
+.status-line.success{color:#7aff9b;}
+.upgrade-hint{display:none;margin-bottom:14px;color:rgba(244,248,252,0.84);font-size:0.95rem;}
+.upgrade-hint a{color:var(--fire2);font-weight:700;text-decoration:none;}
+.upgrade-hint a:hover{color:var(--fire3);text-decoration:underline;}
+/* Result box */
+.result-box{min-height:200px;background:rgba(255,107,26,0.03);border:1px solid rgba(255,107,26,0.1);border-left:2px solid var(--fire1);padding:18px;white-space:pre-wrap;color:rgba(244,248,252,0.92);font-size:0.95rem;line-height:1.7;}
+.tip{margin-top:10px;color:var(--steel3);font-size:0.87rem;line-height:1.6;}
+/* Footer */
+.site-footer{border-top:1px solid rgba(255,107,26,0.06);max-width:1100px;margin:0 auto;padding:28px 24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;}
