+      </div>
+
+      <div class="meta-row">
+        <div><span id="charCount">0</span>/1800 characters</div>
+        <div id="usageText">Checking account status...</div>
+      </div>
+
+      <div class="actions">
+        <button id="runBtn" class="primary-btn">Run Research</button>
+        <button id="copyBtn" class="secondary-btn" disabled>Copy Result</button>
+        <button id="clearBtn" class="secondary-btn">Clear</button>
+      </div>
+
+      
+      <div class="privacy-note"><span class="privacy-icon">&#x1F512;</span> Your data is never stored or shared</div>
+      <div id="statusLine" class="status-line"></div>
+
