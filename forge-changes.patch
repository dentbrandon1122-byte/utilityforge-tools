+      "I answered customer calls, handled complaints, and helped solve account problems.",
+      "I scheduled appointments, kept records organized, and helped with front desk duties.",
+      "I installed software, helped users troubleshoot issues, and kept systems updated."
+    ];
+
+    const examplesWrap = document.getElementById("examples");
+    const inputText = document.getElementById("inputText");
+    const modeSelect = document.getElementById("modeSelect");
+    const charCount = document.getElementById("charCount");
