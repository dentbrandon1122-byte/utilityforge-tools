+    ];
+
+    let previewIndex = 0;
+    let typingIndex = 0;
+    let deleting = false;
+    let currentScene = previewScenes[0];
+
+    const previewInput = document.getElementById("previewInput");
+    const previewOutput = document.getElementById("previewOutput");
+
+    function getStoredAccount() {
+      const raw = localStorage.getItem("uf_account");
+      if (!raw) return null;
+      try {
+        return JSON.parse(raw);
+      } catch {
+        return null;
+      }
+    }
+
+    async function hydrateSession() {
+      try {
+        const res = await fetch("/api/session");
+        const data = await res.json();
+
+        if (data.loggedIn && data.user) {
+          localStorage.setItem("uf_account", JSON.stringify({
+            id: data.user.id,
+            email: data.user.email,
+            name: data.user.name || "",
+            pro: !!data.pro
+          }));
+        } else {
+          localStorage.removeItem("uf_account");
+        }
+      } catch {
+        localStorage.removeItem("uf_account");
+      }
+    }
+
+    function updateAuthUI() {
+      const account = getStoredAccount();
+      const loggedIn = !!account?.id;
+      const isPro = !!account?.pro;
+
+      loginLink.classList.toggle("hidden", loggedIn);
+      signupLink.classList.toggle("hidden", loggedIn);
+      logoutBtn.classList.toggle("hidden", !loggedIn);
+
+      if (isPro) {
+        navCta.textContent = "Pro Active";
+        navCta.href = "dashboard.html";
+      } else {
+        navCta.textContent = "Start Pro";
+        navCta.href = "pricing.html";
+      }
+    }
+
+    async function syncProUI() {
+      const account = getStoredAccount();
+      if (!account?.id) return;
+
+      try {
+        const res = await fetch("/api/pro-status", {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({ userId: account.id })
+        });
+
+        const raw = await res.text();
+        let data;
+        try {
+          data = JSON.parse(raw);
+        } catch {
+          return;
+        }
+
+        if (data.pro) {
+          localStorage.setItem("uf_account", JSON.stringify({
+            ...account,
+            pro: true
+          }));
+          updateAuthUI();
+        }
+      } catch {}
+    }
+
+    async function logout() {
+      try {
+        await fetch("/api/logout", { method: "POST" });
+      } catch {}
+
+      localStorage.removeItem("uf_account");
+      window.location.href = "index.html";
+    }
+
+    function animatePreview() {
+      currentScene = previewScenes[previewIndex];
+      previewInput.textContent = currentScene.input;
+
+      if (!deleting) {
+        typingIndex++;
+        previewOutput.textContent = currentScene.output.slice(0, typingIndex);
+
+        if (typingIndex >= currentScene.output.length) {
+          deleting = true;
+          setTimeout(animatePreview, 1500);
+          return;
+        }
+      } else {
+        typingIndex--;
+        previewOutput.textContent = currentScene.output.slice(0, typingIndex);
+
+        if (typingIndex <= 0) {
+          deleting = false;
+          previewIndex = (previewIndex + 1) % previewScenes.length;
+        }
+      }
+
+      const speed = deleting ? 20 : 30;
+      setTimeout(animatePreview, speed);
+    }
+
+    logoutBtn.addEventListener("click", logout);
+
+    (async function init() {
+      await hydrateSession();
+      updateAuthUI();
+      await syncProUI();
+      previewInput.textContent = previewScenes[0].input;
+      animatePreview();
+      document.body.classList.add("auth-ready");
+    })();
