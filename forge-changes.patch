+  <script>
+    const TOOL_KEY = "idea";
+    const API_PATH = "/api/idea-generator";
+    const toolName = "Ideas";
+    let loadingInterval = null;
+
+    const EXAMPLES = [
+      "Generate business ideas for AI tools that help local service companies.",
+      "Give me content ideas for a cybersecurity beginner brand.",
+      "Brainstorm creative project ideas around space, science, and technology."
+    ];
+
+    const examplesWrap = document.getElementById("examples");
+    const inputText = document.getElementById("inputText");
+    const modeSelect = document.getElementById("modeSelect");
+    const charCount = document.getElementById("charCount");
+    const usageText = document.getElementById("usageText");
+    const usagePill = document.getElementById("usagePill");
+    const navUpgradeBtn = document.getElementById("navUpgradeBtn");
+    const loginLink = document.getElementById("loginLink");
+    const signupLink = document.getElementById("signupLink");
+    const logoutBtn = document.getElementById("logoutBtn");
+    const runBtn = document.getElementById("runBtn");
+    const copyBtn = document.getElementById("copyBtn");
+    const clearBtn = document.getElementById("clearBtn");
+    const resultBox = document.getElementById("resultBox");
+    const statusLine = document.getElementById("statusLine");
+    const upgradeHint = document.getElementById("upgradeHint");
+
+    let lastOutput = "";
+
+    function getGuestUserId() {
+      let id = localStorage.getItem("uf_user_id");
+      if (!id) {
+        id = crypto.randomUUID();
+        localStorage.setItem("uf_user_id", id);
+      }
+      return id;
+    }
+
+    function getStoredAccount() {
+      const raw = localStorage.getItem("uf_account");
+      if (!raw) return null;
+      try {
+        return JSON.parse(raw);
+      } catch {
+        return null;
+      }
+    }
+
+    function getUserId() {
+      const account = getStoredAccount();
+      if (account?.id) return account.id;
+      return getGuestUserId();
+    }
+
+    async function hydrateSession() {
+      try {
+        const res = await fetch("/api/session");
+        const data = await res.json();
+
+        if (data.loggedIn && data.user) {
+          localStorage.setItem("uf_account", JSON.stringify({
+            id: data.user.id,
+            email: data.user.email,
+            name: data.user.name || "",
+            pro: !!data.pro
+          }));
+        } else {
+          localStorage.removeItem("uf_account");
+        }
+      } catch {
+        localStorage.removeItem("uf_account");
+      }
+    }
+
+    function updateAuthUI() {
+      const account = getStoredAccount();
+      const loggedIn = !!account?.id;
+
+      loginLink.classList.toggle("hidden", loggedIn);
+      signupLink.classList.toggle("hidden", loggedIn);
+      logoutBtn.classList.toggle("hidden", !loggedIn);
+    }
+
+    function updateCount() {
+      charCount.textContent = inputText.value.length;
+    }
+
+    function setStatus(message = "", type = "") {
+      statusLine.textContent = message;
+      statusLine.className = "status-line" + (type ? ` ${type}` : "");
+    }
+
+    function setUsageUI(data) {
+      if (data.pro) {
+        usagePill.textContent = "Pro Plan • Unlimited";
+        usagePill.classList.add("pro");
+        usageText.textContent = "Unlimited usage active on this tool.";
+        navUpgradeBtn.classList.add("hidden");
+      } else {
+        usagePill.textContent = `Free uses left: ${data.remaining}`;
+        usagePill.classList.remove("pro");
+        usageText.textContent = `Free uses left today: ${data.remaining}`;
+        navUpgradeBtn.classList.remove("hidden");
+      }
+    }
+
+    function hideUpgradeHint() {
+      upgradeHint.style.display = "none";
+    }
+
+    function showUpgradeHint() {
+      upgradeHint.style.display = "block";
+    }
+
+    function startForgingState() {
+      let dots = 0;
+      runBtn.disabled = true;
+      copyBtn.disabled = true;
+      runBtn.textContent = "Forging...";
+      setStatus(`Forging ${toolName}...`);
+      resultBox.textContent = `Forging ${toolName}...`;
+
+      loadingInterval = setInterval(() => {
+        dots = (dots + 1) % 4;
+        const dotStr = ".".repeat(dots || 1);
+        runBtn.textContent = `Forging${dotStr}`;
+        resultBox.textContent = `Forging ${toolName}${dotStr}`;
+      }, 400);
+    }
+
+    function stopForgingState() {
+      if (loadingInterval) {
+        clearInterval(loadingInterval);
+        loadingInterval = null;
+      }
+      runBtn.disabled = false;
+      runBtn.textContent = "Generate Ideas";
+    }
+
+    async function safeJsonFromResponse(res) {
+      const raw = await res.text();
+      try {
+        return JSON.parse(raw);
+      } catch {
+        throw new Error(raw || "Server returned an invalid response.");
+      }
+    }
+
+    async function loadUsage() {
+      try {
+        const res = await fetch(`/api/usage-status?userId=${encodeURIComponent(getUserId())}&tool=${encodeURIComponent(TOOL_KEY)}`);
+        const data = await safeJsonFromResponse(res);
+        setUsageUI(data);
+      } catch {
+        usagePill.textContent = "Usage unavailable";
+        usageText.textContent = "Usage unavailable";
+      }
+    }
+
+    async function syncUpgradeUI() {
+      const account = getStoredAccount();
+      if (!account?.id) return;
+
+      try {
+        const res = await fetch("/api/pro-status", {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({ userId: account.id })
+        });
+
+        const raw = await res.text();
+        let data;
+
+        try {
+          data = JSON.parse(raw);
+        } catch {
+          return;
+        }
+
+        if (data.pro) {
+          localStorage.setItem("uf_account", JSON.stringify({
+            ...account,
+            pro: true
+          }));
+          setUsageUI({ pro: true });
+        }
+      } catch {}
+    }
+
+    async function startCheckout() {
+      try {
+        const response = await fetch("/api/checkout", {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({ userId: getUserId() })
+        });
+
+        const data = await safeJsonFromResponse(response);
+
+        if (data.url) {
+          window.location.href = data.url;
+        } else {
+          alert(data.error || "Unable to start checkout.");
+        }
+      } catch (error) {
+        console.error("Checkout error:", error);
+        alert(error.message || "Something went wrong starting checkout.");
+      }
+    }
+
+    async function logout() {
+      try {
+        await fetch("/api/logout", { method: "POST" });
+      } catch {}
+
+      localStorage.removeItem("uf_account");
+      window.location.href = "index.html";
+    }
+
+    navUpgradeBtn.addEventListener("click", startCheckout);
+    logoutBtn.addEventListener("click", logout);
+
+    EXAMPLES.forEach((example) => {
+      const btn = document.createElement("button");
+      btn.className = "example-chip";
+      btn.type = "button";
+      btn.textContent = example.length > 34 ? example.slice(0, 34) + "..." : example;
+      btn.title = example;
+
+      btn.addEventListener("click", () => {
+        inputText.value = example;
+        updateCount();
+        setStatus("");
+        hideUpgradeHint();
+      });
+
+      examplesWrap.appendChild(btn);
+    });
+
+    inputText.addEventListener("input", updateCount);
+
+    clearBtn.addEventListener("click", () => {
+      inputText.value = "";
+      resultBox.textContent = "Your generated ideas will appear here.";
+      copyBtn.disabled = true;
+      lastOutput = "";
+      updateCount();
+      setStatus("");
+      hideUpgradeHint();
+    });
+
+    copyBtn.addEventListener("click", async () => {
+      if (!lastOutput) return;
+      try {
+        await navigator.clipboard.writeText(lastOutput);
+        copyBtn.textContent = "Copied ✓";
+        setStatus("Result copied to clipboard.", "success");
+      } catch {
+        copyBtn.textContent = "Copy failed";
+        setStatus("Copy failed. Try again.", "error");
+      }
+
+      setTimeout(() => {
+        copyBtn.textContent = "Copy Result";
+      }, 1400);
+    });
+
+    runBtn.addEventListener("click", async () => {
+      const text = inputText.value.trim();
+      const mode = modeSelect.value;
+
+      if (!text) {
+        resultBox.textContent = "Please enter what you want ideas for first.";
+        setStatus("Please enter what you want ideas for first.", "error");
+        hideUpgradeHint();
+        return;
+      }
+
+      hideUpgradeHint();
+      startForgingState();
+
+      try {
+        const res = await fetch(API_PATH, {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({ text, mode, userId: getUserId() })
+        });
+
+        const data = await safeJsonFromResponse(res);
+
+        if (!res.ok) {
+          console.error("Idea generator error:", data);
+          resultBox.textContent = "Something went wrong. Please try again.";
+          setStatus(data.error || "Something went wrong.", "error");
+
+          if ((data.error || "").includes("Daily free limit reached")) {
+            showUpgradeHint();
+          }
+
+          await loadUsage();
+          return;
+        }
+
+        lastOutput = data.result || "";
+        resultBox.innerText = lastOutput || "No result returned.";
+        copyBtn.disabled = !lastOutput;
+        setUsageUI(data);
+        setStatus(data.pro ? `${toolName} forged successfully (Pro).` : `${toolName} forged successfully.`, "success");
+      } catch (error) {
+        console.error("Idea request failed:", error);
+        resultBox.textContent = "Something went wrong. Please try again.";
+        setStatus(error.message || "Request failed.", "error");
+      } finally {
+        stopForgingState();
+      }
+    });
+
+    (async function init() {
+      await hydrateSession();
+      updateAuthUI();
+      updateCount();
+      await loadUsage();
+      await syncUpgradeUI();
+      document.body.classList.add("auth-ready");
+    })();
+  </script>
