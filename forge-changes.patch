+  <script>
+    const TOOL_KEY = "competitor-analyzer";
+    const API_PATH = "/api/competitor-analyzer";
+    const toolName = "Competitor Analysis";
+    let loadingInterval = null;
+    let isRunning = false;
+
+    const EXAMPLES = [
+      "Analyze this local web design agency homepage for positioning, trust signals, and weak differentiation.",
+      "Review this SaaS competitor’s messaging and offer structure to find strengths and blind spots.",
+      "Compare this coaching website’s service page for authority, clarity, and conversion positioning."
+    ];
+
+    const examplesWrap = document.getElementById("examples");
+    const inputText = document.getElementById("inputText");
+    const modeSelect = document.getElementById("modeSelect");
+    const charCount = document.getElementById("charCount");
+    const usageText = document.getElementById("usageText");
+    const usagePill = document.getElementById("usagePill");
+    const navUpgradeBtn = document.getElementById("navUpgradeBtn");
+    const loginLink = document.getElementById("loginLink");
+    const signupLink = document.getElementById("signupLink");
+    const logoutBtn = document.getElementById("logoutBtn");
+    const runBtn = document.getElementById("runBtn");
+    const copyBtn = document.getElementById("copyBtn");
+    const clearBtn = document.getElementById("clearBtn");
+    const resultBox = document.getElementById("resultBox");
+    const statusLine = document.getElementById("statusLine");
+    const upgradeHint = document.getElementById("upgradeHint");
+
+    let lastOutput = "";
+
+    function getGuestUserId() {
+      let id = localStorage.getItem("uf_user_id");
+      if (!id) {
+        id = crypto.randomUUID();
+        localStorage.setItem("uf_user_id", id);
+      }
+      return id;
+    }
+
+    function getStoredAccount() {
+      const raw = localStorage.getItem("uf_account");
+      if (!raw) return null;
+      try {
+        return JSON.parse(raw);
+      } catch {
+        return null;
+      }
+    }
+
+    function getUserId() {
+      const account = getStoredAccount();
+      if (account?.id) return account.id;
+      return getGuestUserId();
+    }
+
+    async function hydrateSession() {
+      try {
+        const res = await fetch("/api/session");
+        const data = await res.json();
+
+        if (data.loggedIn && data.user) {
+          localStorage.setItem("uf_account", JSON.stringify({
+            id: data.user.id,
+            email: data.user.email,
+            name: data.user.name || "",
+            pro: !!data.pro
+          }));
+        } else {
+          localStorage.removeItem("uf_account");
+        }
+      } catch {
+        localStorage.removeItem("uf_account");
+      }
+    }
+
+    function updateAuthUI() {
+      const account = getStoredAccount();
+      const loggedIn = !!account?.id;
+      const isPro = !!account?.pro;
+
+      loginLink.classList.toggle("hidden", loggedIn);
+      signupLink.classList.toggle("hidden", loggedIn);
+      logoutBtn.classList.toggle("hidden", !loggedIn);
+
+      if (isPro) {
+        navUpgradeBtn.classList.add("hidden");
+      } else {
+        navUpgradeBtn.classList.remove("hidden");
+      }
+    }
+
+    function updateCount() {
+      charCount.textContent = inputText.value.length;
+    }
+
+    function setStatus(message = "", type = "") {
+      statusLine.textContent = message;
+      statusLine.className = "status-line" + (type ? ` ${type}` : "");
+    }
+
+    function setUsageUI(data) {
+      if (data.pro) {
+        usagePill.textContent = "Pro Plan • Unlimited";
+        usagePill.classList.add("pro");
+        usageText.textContent = "Unlimited usage active on this tool.";
+        navUpgradeBtn.classList.add("hidden");
+      } else {
+        usagePill.textContent = `Free uses left: ${data.remaining}`;
+        usagePill.classList.remove("pro");
+        usageText.textContent = `Free uses left today: ${data.remaining}`;
+        navUpgradeBtn.classList.remove("hidden");
