+.price-card.featured{background:var(--iron2);outline:1px solid rgba(255,107,26,0.2);}
+.price-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--ember),var(--fire2));opacity:0.3;}
+.price-card.featured::before{opacity:0.8;}
+.price-tier{font-family:'Rajdhani',sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:var(--fire2);margin-bottom:16px;}
+.price-amount{font-family:'Barlow Condensed',sans-serif;font-size:3rem;font-weight:800;color:var(--white);line-height:1;margin-bottom:4px;}
+.price-amount span{font-size:1rem;color:var(--steel3);}
+.price-desc{font-size:0.9rem;color:var(--steel3);margin-bottom:24px;}
+.price-features{list-style:none;margin-bottom:28px;}
+.price-features li{font-size:0.92rem;color:rgba(244,248,252,0.82);padding:8px 0;border-bottom:1px solid rgba(255,107,26,0.06);display:flex;align-items:center;gap:10px;}
+.price-features li::before{content:'→';color:var(--fire2);font-weight:700;}
+.price-btn{display:block;text-align:center;padding:13px 28px;font-family:'Barlow Condensed',sans-serif;font-size:0.95rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;transition:all 0.22s;cursor:pointer;border:none;}
+.price-btn-outline{background:transparent;color:var(--steel2);border:1px solid rgba(200,216,228,0.15);}
+.price-btn-outline:hover{border-color:var(--steel2);color:var(--white);}
+.price-btn-fire{background:linear-gradient(135deg,var(--fire1),var(--fire2));color:#fff;clip-path:polygon(6px 0%,100% 0%,calc(100% - 6px) 100%,0% 100%);box-shadow:0 4px 20px rgba(255,107,26,0.25);}
+.price-btn-fire:hover{transform:translateY(-1px);box-shadow:0 8px 32px rgba(255,107,26,0.4);}
+/* Dashboard / account panels */
+.dashboard-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1px;background:rgba(255,107,26,0.1);margin-top:32px;}
+.dash-card{background:var(--iron);padding:28px;position:relative;overflow:hidden;text-decoration:none;display:block;transition:background 0.22s;}
+.dash-card:hover{background:var(--iron2);}
+.dash-card::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--ember),var(--fire2));transform:scaleX(0);transition:transform 0.3s;transform-origin:left;}
+.dash-card:hover::after{transform:scaleX(1);}
+.dash-icon{font-size:1.6rem;margin-bottom:12px;display:block;}
