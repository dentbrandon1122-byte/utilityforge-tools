+      runBtn.textContent = "Forging...";
+      setStatus(`Forging ${toolName}...`);
+      resultBox.textContent = `Forging ${toolName}...`;
+
+      loadingInterval = setInterval(() => {
+        dots = (dots + 1) % 4;
+        const dotStr = ".".repeat(dots || 1);
+        runBtn.textContent = `Forging${dotStr}`;
+        resultBox.textContent = `Forging ${toolName}${dotStr}`;
+      }, 400);
+    }
+
+    function stopForgingState() {
+      if (loadingInterval) {
+        clearInterval(loadingInterval);
+        loadingInterval = null;
+      }
+      runBtn.disabled = false;
+      runBtn.textContent = "Analyze Offer";
+    }
+
+    async function safeJsonFromResponse(res) {
+      const raw = await res.text();
+      try {
+        return JSON.parse(raw);
+      } catch {
+        throw new Error(raw || "Server returned an invalid response.");
+      }
+    }
+
+    async function loadUsage() {
+      try {
+        const res = await fetch(`/api/usage-status?userId=${encodeURIComponent(getUserId())}&tool=${encodeURIComponent(TOOL_KEY)}`);
+        const data = await safeJsonFromResponse(res);
+        setUsageUI(data);
+      } catch {
+        usagePill.textContent = "Usage unavailable";
+        usageText.textContent = "Usage unavailable";
+      }
+    }
+
+    async function syncUpgradeUI() {
+      const account = getStoredAccount();
+      if (!account?.id) return;
+
+      try {
+        const res = await fetch("/api/pro-status", {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({ userId: account.id })
+        });
+
+        const raw = await res.text();
+        let data;
+
+        try {
+          data = JSON.parse(raw);
+        } catch {
+          return;
+        }
+
+        if (data.pro) {
+          localStorage.setItem("uf_account", JSON.stringify({
+            ...account,
+            pro: true
+          }));
+          setUsageUI({ pro: true });
+          updateAuthUI();
+        }
+      } catch {}
+    }
+
+    async function startCheckout() {
+      try {
+        const response = await fetch("/api/checkout", {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({ userId: getUserId() })
+        });
+
+        const data = await safeJsonFromResponse(response);
+
+        if (data.url) {
+          window.location.href = data.url;
+        } else {
+          alert(data.error || "Unable to start checkout.");
+        }
+      } catch (error) {
+        console.error("Checkout error:", error);
+        alert(error.message || "Something went wrong starting checkout.");
+      }
+    }
+
+    async function logout() {
+      try {
+        await fetch("/api/logout", { method: "POST" });
+      } catch {}
+
+      localStorage.removeItem("uf_account");
+      window.location.href = "index.html";
+    }
+
+    navUpgradeBtn.addEventListener("click", startCheckout);
+    logoutBtn.addEventListener("click", logout);
+
+    EXAMPLES.forEach((example) => {
+      const btn = document.createElement("button");
+      btn.className = "example-chip";
+      btn.type = "button";
+      btn.textContent = example.length > 38 ? example.slice(0, 38) + "..." : example;
+      btn.title = example;
+
+      btn.addEventListener("click", () => {
+        inputText.value = example;
+        updateCount();
+        setStatus("");
+        hideUpgradeHint();
+      });
+
+      examplesWrap.appendChild(btn);
+    });
+
+    inputText.addEventListener("input", updateCount);
+
+    clearBtn.addEventListener("click", () => {
+      inputText.value = "";
+      resultBox.textContent = "Your offer analysis will appear here.";
+      copyBtn.disabled = true;
+      lastOutput = "";
+      updateCount();
+      setStatus("");
+      hideUpgradeHint();
+    });
+
+    copyBtn.addEventListener("click", async () => {
+      if (!lastOutput) return;
+      try {
+        await navigator.clipboard.writeText(lastOutput);
+        copyBtn.textContent = "Copied ✓";
+        setStatus("Result copied to clipboard.", "success");
+      } catch {
+        copyBtn.textContent = "Copy failed";
+        setStatus("Copy failed. Try again.", "error");
+      }
+
+      setTimeout(() => {
+        copyBtn.textContent = "Copy Result";
+      }, 1400);
+    });
+
+    runBtn.addEventListener("click", async () => {
+      if (isRunning) return;
+      isRunning = true;
+
+      const text = inputText.value.trim();
+      const mode = modeSelect.value;
+
+      if (!text) {
+        resultBox.textContent = "Please enter offer details first.";
+        setStatus("Please enter offer details first.", "error");
+        hideUpgradeHint();
+        isRunning = false;
+        return;
+      }
+
+      hideUpgradeHint();
+      startForgingState();
+
+      try {
+        const res = await fetch(API_PATH, {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({ text, mode, userId: getUserId() })
+        });
+
+        const data = await safeJsonFromResponse(res);
+
+        if (!res.ok) {
+          console.error("Offer analyzer error:", data);
+          resultBox.textContent = "Something went wrong. Please try again.";
+          setStatus(data.error || "Something went wrong.", "error");
+
+          if ((data.error || "").includes("Daily free limit reached")) {
+            showUpgradeHint();
+          }
+
+          await loadUsage();
+          return;
+        }
+
+        lastOutput = data.result || "";
+        resultBox.innerText = lastOutput || "No result returned.";
+        copyBtn.disabled = !lastOutput;
+        setUsageUI(data);
+        setStatus(data.pro ? `${toolName} forged successfully (Pro).` : `${toolName} forged successfully.`, "success");
+      } catch (error) {
+        console.error("Offer analyzer request failed:", error);
+        resultBox.textContent = "Something went wrong. Please try again.";
+        setStatus(error.message || "Request failed.", "error");
+      } finally {
+        stopForgingState();
+        isRunning = false;
+      }
+    });
+
+    (async function init() {
+      await hydrateSession();
+      updateAuthUI();
+      updateCount();
+      await loadUsage();
+      await syncUpgradeUI();
+      document.body.classList.add("auth-ready");
+    })();
+  </script>
+<footer class="site-footer">
+  <span class="foot-copy">© 2025 Utility Forge AI. All rights reserved.</span>
+  <div class="foot-links">
+    <a href="privacy-policy.html">Privacy</a>
+    <a href="terms.html">Terms</a>
+    <a href="contact.html">Contact</a>
+  </div>
+</footer>
+</body>
+</html>
