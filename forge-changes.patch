-    const EXAMPLES = [
-      "Cybersecurity internship requiring Python, networking, troubleshooting, and strong communication skills.",
-      "Administrative assistant role focused on scheduling, records, communication, and office organization.",
-      "Customer service position requiring conflict resolution, communication, sales support, and multitasking.",
