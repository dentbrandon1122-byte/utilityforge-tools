+
+      <p class="inline-links">
+        Try also:
+        <a href="idea-generator.html">Idea Generator</a> |
+        <a href="text-summarizer.html">Text Summarizer</a>
+      </p>
+    </section>
+
+    <section class="card">
+      <div class="top-row">
+        <div class="top-copy">
+          <div class="tool-badge">Built for structured research</div>
+          <h2 class="title">Research Assistant</h2>
+          <p class="subtitle">Use one tool for general research, study help, issue spotting, and structured topic breakdowns.</p>
+        </div>
+
+        <div id="usagePill" class="usage-pill">Loading usage...</div>
+      </div>
+
+      <label class="examples-label">Quick start examples</label>
+      <div class="examples" id="examples"></div>
+
+      <div class="grid">
+        <div>
+          <label for="inputText" class="field-label">Research topic or question</label>
+          <textarea id="inputText" maxlength="1800" placeholder="Paste your research topic, question, issue, or topic breakdown request here..."></textarea>
+        </div>
+
+        <div>
+          <label for="modeSelect" class="field-label">Mode</label>
+          <select id="modeSelect">
+            <option value="general">General Research</option>
+            <option value="study">Study Help</option>
+            <option value="issue-spotting">Issue Spotting</option>
+            <option value="structured">Structured Breakdown</option>
+          </select>
