+      <h2>More tools to keep your workflow moving</h2>
+      <p>
+        Use related tools to improve writing, summarize faster, and get cleaner output across your workflow.
+      </p>
+
+      <div class="related-tools-links">
+        <a href="idea-generator.html">Idea Generator</a>
+        <a href="text-summarizer.html">Text Summarizer</a>
+        <a href="email-polisher.html">Email Polisher</a>
+        <a href="job-analyzer.html">Job Analyzer</a>
+      </div>
