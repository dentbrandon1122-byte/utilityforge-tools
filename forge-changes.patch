+  position:absolute;bottom:-300px;left:50%;transform:translateX(-50%);
+  width:800px;height:400px;
+  background:radial-gradient(ellipse, rgba(255,107,26,0.05) 0%, rgba(255,61,0,0.02) 40%, transparent 70%);
